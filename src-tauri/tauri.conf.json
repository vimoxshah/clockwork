{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clockwork",
  "version": "0.2.0",
  "identifier": "com.clockwork.app",
  "build": {
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clockwork",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "url": "http://127.0.0.1:4747"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}

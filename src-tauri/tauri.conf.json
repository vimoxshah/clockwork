{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clockwork",
  "version": "0.12.0",
  "identifier": "com.clockwork.app",
  "build": {
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4747; font-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "resources/app/": "app/"
    },
    "externalBin": [
      "binaries/node"
    ]
  }
}

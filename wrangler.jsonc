{
  // Cloudflare Workers Static Assets — serves the marketing site and the DMG.
  //
  // The dashboard's git flow now defaults to Workers rather than Pages, so
  // there is no "build output directory" field; the directory is declared
  // here instead. Deploy command stays the auto-filled `npx wrangler deploy`.
  //
  // Assets-only: no `main` script, so nothing runs server-side — this is a
  // static host with Cloudflare's CDN in front, on the free plan.
  "name": "clockwork",
  "compatibility_date": "2026-09-01",
  // The Worker owns exactly one route (POST /subscribe) and hands everything
  // else to the static assets via env.ASSETS.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./landing-page",
    // Serve /downloads/... and the DMG as-is; no SPA rewriting.
    "not_found_handling": "404-page",
    // Required so the Worker can serve the site through env.ASSETS.
    "binding": "ASSETS"
  }
,

  // Signup storage. This MUST stay declared here: a deploy from a config
  // without it silently drops a binding added through the dashboard, which is
  // exactly how signup broke once already. A namespace id is an identifier,
  // not a secret — it is useless without account credentials.
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "f3016353cd8046e5893796fb82276113" }
  ]
}

.idea/
.vscode/*
!.vscode/extensions.json

# Logs
logs/
*.log

# Tauri / Rust build artifacts
src-tauri/target/
src-tauri/gen/

# Spike throwaway artifacts (Phase 0 keeps reports, not scratch repos)
spikes/scratch/
spikes/out/*.local/

# Tauri build artifacts
src-tauri/target/
src-tauri/app-icon.png.orig/

# Per-session hook state — machine-local, never source.
.genea/subagent-state.json

# Product Hunt / launch prep — drafts, unpublished copy, generated assets.
# The repo is PUBLIC: launch copy stays local until it is actually published.
launch/

# Staged by tools/stage-bundle.mjs before `tauri build` — ~195MB of Node and
# production node_modules, reproducible from the lockfile, never committed.
src-tauri/resources/app/
src-tauri/binaries/

# Next-level planning — working docs with solutions and task tracking for the
# cross-OS / UX / feedback tracks. Local until a track ships; the honesty tests
# read plan/ and docs/, so these live outside both on purpose.
tracks/

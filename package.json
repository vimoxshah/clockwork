{
  "name": "clockwork",
  "version": "0.12.0",
  "private": true,
  "description": "The calendar where your agents show up for work.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint 'packages/*/src/**/*.ts?(x)' 'packages/*/test/**/*.ts' 'spikes/src/**/*.ts'",
    "typecheck": "tsc -b packages/shared packages/runner packages/daemon && tsc --noEmit -p packages/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --filter './packages/*' build",
    "daemon:dev": "pnpm --filter @clockwork/daemon dev",
    "bundle:stage": "node tools/stage-bundle.mjs",
    "app:build": "pnpm build && node tools/stage-bundle.mjs && APPLE_SIGNING_IDENTITY=\"-\" ./node_modules/.bin/tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
